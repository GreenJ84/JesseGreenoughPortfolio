# Local development configuration template
# Copy to .env in the project root, then replace every placeholder before use.
# .env is ignored by Git. Never commit an edited copy with credentials.

# Application database. Use a local, disposable MongoDB database for development.
# The database name must match PersonalPortfolioDev_YYYYMMDD_XXXXXXXX, where
# XXXXXXXX is eight lowercase hexadecimal characters. Production uses the
# PersonalPortfolio database name and a separate, least-privilege credential.
DB_CONN_STRING=mongodb://127.0.0.1:27017/PersonalPortfolioDev_YYYYMMDD_XXXXXXXX

# Authentication. Generate a random secret of at least 32 bytes and a unique
# owner password of 16–1024 characters. The password is used only to enroll the
# first passkey; after enrollment, sign-in requires a passkey.
JWT_SECRET=<random-secret-at-least-32-bytes>
ADMIN_USERNAME=<owner-username>
ADMIN_PASSWORD=<unique-bootstrap-password>

# Passkeys. These local defaults work when the browser uses localhost:3000.
# Production requires the exact HTTPS origin and its matching hostname. Set
# both before enrolling production passkeys; existing passkeys are origin-bound.
ADMIN_PASSKEY_ORIGIN=http://localhost:3000
ADMIN_PASSKEY_RP_ID=localhost

# Contact form and operational alerts. The sender must be a Gmail address and
# USER_PASS must be an application password for that account. CONTACT_EMAIL is
# the recipient of contact messages. ADMIN_ALERT_EMAIL is optional; leave it
# empty to keep alerts in the admin dashboard without sending alert mail.
USER_EMAIL=<gmail-sender-address>
USER_PASS=<gmail-application-password>
CONTACT_EMAIL=<contact-recipient-address>
ADMIN_ALERT_EMAIL=

# Cloudinary admin media. Set the cloud identifier at build time and runtime.
# Its image delivery URLs must match this tenant. API credentials are server-side
# only; do not rename them with a NEXT_PUBLIC_ prefix.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Optional client-IP limits. Leave blank unless the deployment proxy overwrites
# the chosen header with one validated IP address and blocks direct access.
TRUSTED_CLIENT_IP_HEADER=

# Manual migration only. Keep this source credential read-only. It points to the
# legacy production database during both local rehearsal and production cutover.
# The migration CLI reads project-root .env or exported shell values; it does not
# load .env.local. Leave this blank for ordinary app development.
PORTFOLIO_SOURCE_URI=

# Optional local JSON report path for migration preview/copy/verify. Use a
# different path for each run so reports do not overwrite one another.
PORTFOLIO_MIGRATION_REPORT=

# This template is for local development. For staging and production, enter the
# corresponding values in the hosting platform's secrets/environment manager.
# Give the application and migration destination only the database permissions
# they need. Keep production URIs, signing keys, email passwords, and Cloudinary
# credentials out of Git, images, build logs, and public environment variables.
# Before a production migration, change only DB_CONN_STRING to the verified
# destination; retain the same read-only PORTFOLIO_SOURCE_URI.
