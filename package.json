{
  "name": "portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "cypress": "cypress run",
    "cypress:full": "cypress run --expose FULL_SPECTRUM=true",
    "typecheck": "tsc --noEmit --incremental false && tsc --noEmit --incremental false -p tsconfig.test.json",
    "test:startup": "node --test tests/database-startup.cjs",
    "test:security": "node --test tests/security.cjs",
    "test": "node --test tests/database-startup.cjs tests/security.cjs tests/config.cjs tests/behavior.cjs tests/observability.cjs",
    "test:config": "node --test tests/config.cjs",
    "test:behavior": "node --test tests/behavior.cjs",
    "analyze": "ANALYZE=true next build --webpack",
    "perf:browser": "node scripts/measure-performance.cjs",
    "perf:bundles": "node scripts/measure-bundles.cjs",
    "data:preview": "node scripts/copy-production-to-local.cjs",
    "data:copy": "node scripts/copy-production-to-local.cjs --apply",
    "test:passkeys": "node scripts/check-owner-passkeys.cjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "@vercel/speed-insights": "^1.0.7",
    "axios": "^1.2.0",
    "dotenv": "^16.0.3",
    "jose": "^6.1.0",
    "mongodb": "6.22.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "react": "19.3.1",
    "react-bootstrap": "^2.6.0",
    "react-dom": "19.3.1",
    "react-github-calendar": "5.0.9",
    "react-icons": "^4.7.1",
    "react-parallax-tilt": "^1.7.72",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.6",
    "@types/lodash": "^4.14.200",
    "@types/node": "22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cypress": "16.3.0",
    "cypress-real-events": "^1.10.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "playwright": "1.65.1"
  },
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  }
}
