{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "cypress",
      "cypress-real-events"
    ],
    "target": "es2018"
  },
  "include": [
    "cypress.config.ts",
    "src/cypress/**/*.ts",
    "src/cypress/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
